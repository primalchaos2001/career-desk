{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/dist-mcp",
      "!**/dist-local",
      "!**/.next",
      "!**/generated",
      "!**/routeTree.gen.ts",
      "!packages/app/src/styles.css",
      "!**/test-results",
      "!**/playwright-report",
      "!cv-guide-lovable",
      "!.claude",
      "!.remember",
      "!.venv",
      "!release"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
